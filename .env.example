# Copie para .env (o .env não vai para o git) e troque TODAS as senhas.

# ── Acesso ───────────────────────────────────────────────────────────────────
# Segredo dos SCRIPTS (header x-api-secret) e da assinatura do cookie do painel. Pessoas entram pelo
# login central (abaixo), não com este segredo. Valor longo e aleatório.
APLOGS_SECRET=troque-este-segredo
# Chave que os serviços/robôs mandam no header x-api-key para enviar heartbeat, logs, jobs...
# Diferente da senha do painel: quem tem só esta chave consegue enviar, mas não ler.
APLOGS_INGEST_KEY=troque-esta-chave-de-envio
# Porta no host (dentro do container a API escuta na 8000)
APLOGS_PORT=3070
# Quanto tempo o login do painel dura (horas)
SESSAO_HORAS=12

# ── Login central (apusers) ──────────────────────────────────────────────────
# O painel pede o e-mail e a senha do apusers. Cadastre o serviço no painel do apusers
# (Serviços → Cadastrar, slug "aplogs") e cole as duas variáveis que ele mostra.
# Sem elas, ninguém entra no painel (a ingestão e os scripts com x-api-secret seguem funcionando).
# Mesma máquina do apusers: http://host.docker.internal:3080 · outra máquina: http://192.168.1.100:3080
APUSERS_URL=http://host.docker.internal:3080
APUSERS_KEY=
# Papel de quem tem acesso à aplogs sem papel definido no apusers (visualizador | operador | gestor)
PAPEL_PADRAO=visualizador

# ── Banco MySQL (container aplogs-db) ────────────────────────────────────────
DB_NAME=aplogs
DB_USER=aplogs
DB_PASSWORD=troque-senha-do-banco
DB_ROOT_PASSWORD=troque-senha-root-do-banco
# Porta do MySQL só nesta máquina (127.0.0.1), para abrir no DBeaver/Workbench
DB_PORT_HOST=3307

# ── Monitor de heartbeat ─────────────────────────────────────────────────────
# A cada quantos segundos a aplogs confere quem parou de mandar heartbeat
MONITOR_INTERVALO_S=10
# Um serviço fica OFFLINE depois de max(3 × intervalo dele, TOLERANCIA_MINIMA_S) sem heartbeat.
# Dá para trocar a tolerância de cada serviço no painel.
TOLERANCIA_MINIMA_S=60
HEARTBEAT_INTERVALO_PADRAO_S=30

# ── Retenção (dias; 0 = guarda para sempre) ──────────────────────────────────
RETENCAO_LOGS_DIAS=30
RETENCAO_HEARTBEATS_DIAS=7
RETENCAO_JOBS_DIAS=30
RETENCAO_PROBLEMAS_DIAS=90
